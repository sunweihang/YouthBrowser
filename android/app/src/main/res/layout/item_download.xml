<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dlTime"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:textColor="@color/jx_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/dlTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jx_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/dlMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jx_muted"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlOpen"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/open" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlFolder"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:text="@string/downloads_show" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dlRemove"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:text="@string/remove"
            android:textColor="@color/jx_danger" />
    </LinearLayout>
</LinearLayout>
