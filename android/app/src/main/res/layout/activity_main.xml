<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jx_bg">

    <!-- Tab strip = desktop .chrome -->
    <LinearLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:background="@color/jx_bg">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/tabsBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="bottom" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewTab"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="+"
            android:textSize="16sp"
            android:contentDescription="@string/menu_new_tab" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/jx_line" />

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@color/jx_toolbar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="←"
            android:contentDescription="@string/back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForward"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="→"
            android:contentDescription="@string/forward" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReload"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="↻"
            android:contentDescription="@string/reload_hint"
            android:tooltipText="@string/reload_hint" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_url_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="@string/url_hint"
            android:textColorHint="@color/jx_muted"
            android:textColor="@color/jx_text"
            android:textSize="13sp"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStar"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="☆"
            android:contentDescription="@string/bookmark" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloads"
                style="@style/Jx.IconBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="↓"
                android:contentDescription="@string/menu_downloads" />

            <TextView
                android:id="@+id/downloadsBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                style="@style/Jx.IconBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="☰"
                android:contentDescription="@string/menu" />

            <TextView
                android:id="@+id/updateBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center"
                android:text="!"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/jx_line" />

    <!-- Bookmarks bar -->
    <HorizontalScrollView
        android:id="@+id/bookmarksScroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:scrollbars="none"
        android:background="@color/jx_bg">

        <LinearLayout
            android:id="@+id/bookmarksBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </HorizontalScrollView>

    <View
        android:id="@+id/bookmarksBarLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/jx_line" />

    <!-- Password offer bar -->
    <LinearLayout
        android:id="@+id/passwordBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/jx_bg2"
        android:visibility="gone">

        <TextView
            android:id="@+id/passwordBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/jx_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/passwordSave"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/save"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/passwordDismiss"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:text="@string/dont_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/passwordClose"
            style="@style/Jx.FindBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:text="×" />
    </LinearLayout>

    <!-- Download progress bar -->
    <LinearLayout
        android:id="@+id/downloadBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/jx_bg2"
        android:visibility="gone">

        <TextView
            android:id="@+id/downloadBarText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/jx_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/downloadBarMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/jx_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadBarOpen"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/open"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadBarShow"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:text="@string/downloads_show"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadBarList"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:text="@string/downloads_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadBarClose"
            style="@style/Jx.FindBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:text="×" />
    </LinearLayout>

    <!-- Homepage bar -->
    <LinearLayout
        android:id="@+id/homepageBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/jx_bg2"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/homepage"
            android:textColor="@color/jx_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/homepageInput"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_find_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:hint="@string/homepage_hint"
            android:textColorHint="@color/jx_muted"
            android:textColor="@color/jx_text"
            android:textSize="13sp"
            android:inputType="textUri"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/homepageError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/jx_danger"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homepageUseCurrent"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:text="@string/homepage_use_current" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homepageClear"
            style="@style/Jx.FindBtn"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:text="@string/homepage_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homepageSave"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/save"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homepageClose"
            style="@style/Jx.FindBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:text="×" />
    </LinearLayout>

    <!-- Find bar -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="@color/jx_bg2"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_label"
            android:textColor="@color/jx_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_find_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:hint="@string/find_hint"
            android:textColorHint="@color/jx_muted"
            android:textColor="@color/jx_text"
            android:textSize="13sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="56dp"
            android:textColor="@color/jx_muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/findPrev"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="↑" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/findNext"
            style="@style/Jx.IconBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:text="↓" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/findClose"
            style="@style/Jx.FindBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:text="×" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/jx_accent"
        android:progressBackgroundTint="@color/jx_line"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/jx_bg" />
</LinearLayout>
