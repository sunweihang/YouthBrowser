<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/histTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jx_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/histTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jx_primary_dark"
            android:textSize="12sp"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/histUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jx_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="middle" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/histOpen"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open"
        android:minWidth="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/histDelete"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remove"
        android:textColor="@color/jx_danger"
        android:minWidth="0dp" />
</LinearLayout>
